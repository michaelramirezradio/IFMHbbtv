<script>

    $(document).on("click", ".btn_programas", function () {
        console.log("mostrando programas...");
        $(".programa_oculto").removeClass("programa_oculto");
        $(".btn_programas").remove();
    });

    $(document).ready(function () {
        $('.bxslider').bxSlider(
            {
                //            pause: 8000,
                mode: 'fade',
                //            speed: 2000,
                pager: false,

                controls: true,
                //flechas//
                nextSelector: '#slider-next',
                prevSelector: '#slider-prev',
                nextText: '<i class="fa fa-chevron-right flechas dos" aria-hidden="true"></i>',
                prevText: '<i class="fa fa-chevron-left flechas uno" aria-hidden="true"></i>'
            }
        );

    });

    // Swipebox

    $(".swipebox").swipebox({

        hideBarsDelay: 0,
        afterOpen: function () {
            var $selectorClose = $("#swipebox-close");
            var clickAction = "touchend click";

            $selectorClose.unbind(clickAction);

            $selectorClose.bind(clickAction, function (event) {
                event.preventDefault();
                event.stopPropagation();

                $.swipebox.close();
            });
        },

    });

    $(window).scroll(function bajar() {
        var scrollTop = $(window).scrollTop();

        $('.menu_bot a').each(function () {

            var currLink = $(this);
            var headerElem = $(currLink.attr("href"));

            if (scrollTop > $(headerElem).offset().top - 155) {

                $('.menu_bot').removeClass("active");

                currLink.parent().addClass("active");
            }

            //        console.log (scrollTop + $(window).height() + 100 );
            //        
            //        console.log ($(document).height());

            if ((scrollTop + $(window).height() + 100) >= $(document).height()) {
                //            console.log("pie");
                $('.menu_bot').removeClass("active");
                $('.menu_bot a[href*="#contactar"]').parent().addClass("active");
            }

        });

    });

</script>



